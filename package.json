{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "php artisan generate:build-options && vue-tsc --noEmit && vite build && cp public/build/manifest.webmanifest public/manifest.webmanifest && vite build --ssr",
        "build:ssr": "php artisan generate:build-options && vue-tsc --noEmit && vite build && cp public/build/manifest.webmanifest public/manifest.webmanifest && vite build --ssr",
        "dev": "php artisan generate:build-options && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "lint:ui": "bunx lintapple https://laravel-charter.test/en/application",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/unplugin-vue-i18n": "^11.2.6",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.5",
        "@vite-pwa/assets-generator": "^2.0.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "chokidar": "^5.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.11.1",
        "fontaine": "^1.0.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.71.2",
        "vite-plugin-pwa": "^2.0.0",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@lucide/vue": "^1.58.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vueuse/core": "^15.0.0",
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "reka-ui": "^2.11.0",
        "shadcn-vue": "^2.8.2",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vue": "^3.5.44",
        "vue-chartjs": "^5.3.4",
        "vue-i18n": "^11.4.14"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.64.7",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}
